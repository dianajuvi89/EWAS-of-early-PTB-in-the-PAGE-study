# Enrichment for Regulatory elements - (Lussier analysis)
```{r}
#prep data 

# dataframe with all CpG tested after QC
alltested_cgs<-combined   # complete dataset with ewas results

# Genome-wide CpGs 
featureData<- manifest # annotation file from Illumina. Same file to the one obtained using the following code: annotation <- meffil.get.features("epic2")
featureData$CHR <- as.character(featureData$CHR)  # GRCh38
featureData$MAPINFO <- as.character(featureData$MAPINFO)
fData <- featureData[featureData$Name %in% alltested_cgs$CpG, ]
fData<- fData %>% distinct(Name, .keep_all=T) 
dim(fData) # 878121
rm(featureData)

#Features for FDR results in Experiment-wide lifecourse models
fdr2 <- top_unique %>% dplyr::select(CpG)
anno.fdr <- fData %>% filter(Name %in% fdr2$CpG) %>%
                                      select(Name,X450k_Enhancer,Regulatory_Feature_Group,DNase_Hypersensitivity_NAME)

cgi.fdr <- fData %>% filter(Name %in% fdr2$CpG) %>% select(Name,Relation_to_UCSC_CpG_Island)
fdr2 <- left_join(fdr2, anno.fdr, by=c("CpG"="Name"))
fdr2 <- left_join(fdr2, cgi.fdr, by=c("CpG"="Name"))
colnames(fdr2)
# tidy up columns
fdr2$Enhancer2 <- ifelse(fdr2$X450k_Enhancer == TRUE, 1, 0)
fdr2$Promoter.Assoc <- ifelse(fdr2$Regulatory_Feature_Group %in% 
                                c("Promoter_Associated", "Promoter_Associated_Cell_type_specific"), 1, 0)
fdr2$DHS <- ifelse(fdr2$DNase_Hypersensitivity_NAME!="", "TRUE","")
fdr2$Relation_to_UCSC_CpG_Island<-gsub(".*;", "",fdr2$Relation_to_UCSC_CpG_Island)
fdr2$Relation_to_UCSC_CpG_Island<-ifelse(fdr2$Relation_to_UCSC_CpG_Island=="", "Open Sea", fdr2$Relation_to_UCSC_CpG_Island)

# features for all cpgs tested in the analysis (n=878121)
anno.autosome <- fData 
anno.autosome$DHS<-ifelse(anno.autosome$DNase_Hypersensitivity_NAME!="", "TRUE","")
anno.autosome$Enhancer2<-ifelse(anno.autosome$X450k_Enhancer == TRUE, 1, 0)
anno.autosome$Promoter.Assoc<-ifelse(anno.autosome$Regulatory_Feature_Group %in% 
                                c("Promoter_Associated", "Promoter_Associated_Cell_type_specific"), 1, 0)
apply(anno.autosome[, c("Enhancer2","Promoter.Assoc", "DHS")], 2, table)

cgi.auto <- fData %>% select(Name, Relation_to_UCSC_CpG_Island)
cgi.auto$Relation_to_UCSC_CpG_Island <- gsub(".*;", "",cgi.auto$Relation_to_UCSC_CpG_Island)
cgi.auto$Relation_to_UCSC_CpG_Island<- ifelse(cgi.auto$Relation_to_UCSC_CpG_Island=="", "Open Sea", cgi.auto$Relation_to_UCSC_CpG_Island)
table(cgi.auto[, 2])

#BACKGROUND DATA 
fData2 <- left_join(anno.autosome[, c("Name","Enhancer2","Promoter.Assoc", "DHS")], cgi.auto, by="Name")
apply(fData2[, 2:ncol(fData2)], 2, table)


#TESTING ENRICHMENT
my.chisq.test <- function(x, y){
  p.1 <- unname(table(x))/sum(unname(table(x)))
  p.2 <- unname(table(y))/sum(unname(table(y)))
  
  ch <- chisq.test(unname(table(x)), p=p.2)
  
  return(c(FDR=p.1, fData=p.2, ch$stat, P=ch$p.val))
}

#' Note: In the output of the Chi.sq, FDRx are the proportions of each level of the variable in the FDR-detected set;
#' fDatax is the proportion of each level of the variable in the background set (e.g., all CpGs tested)

## Enhancers
ch1  <- my.chisq.test(x=fdr2$Enhancer2, y=fData2$Enhancer2)
ch1
#      FDR1      FDR2    fData1    fData2 X-squared         P 
# 0.6666667 0.3333333 0.7533780 0.2466220 1.0926226 0.2958908 

## Promoters
fdr2$Promoter.Assoc <- factor(fdr2$Promoter.Assoc, levels =c (0,1))
ch2 <- my.chisq.test(x=fdr2$Promoter.Assoc, y=fData2$Promoter.Assoc)
ch2
 #        FDR1         FDR2       fData1       fData2    X-squared            P 
 # 0.666666667  0.333333333  0.872514152  0.127485848 10.285382372  0.001340882 
 
## DNA Hypersensitive sites (open chromatine)
fdr2$DHS <- factor(fdr2$DHS, levels = c("","TRUE"))
fData2$DHS <- factor(fData2$DHS, levels = c("","TRUE"))
ch3<- my.chisq.test(x = fdr2$DHS, y= fData2$DHS)
ch3
#      FDR1      FDR2    fData1    fData2 X-squared         P 
# 0.4074074 0.5925926 0.3447418 0.6552582 0.4693708 0.4932768 

## CpG islands relationship
fdr2$Relation_to_UCSC_CpG_Island <- factor(fdr2$Relation_to_UCSC_CpG_Island, 
                                  levels = c("Open Sea", "Island","N_Shelf","N_Shore","S_Shelf","S_Shore"))
fData2$Relation_to_UCSC_CpG_Island <- factor(fData2$Relation_to_UCSC_CpG_Island, 
                                  levels = c("Open Sea", "Island","N_Shelf","N_Shore","S_Shelf","S_Shore"))
ch4 <- my.chisq.test(x=fdr2$Relation_to_UCSC_CpG_Island, y=fData2$Relation_to_UCSC_CpG_Island)
ch4
#       FDR1       FDR2       FDR3       FDR4       FDR5       FDR6     fData1     fData2     fData3     fData4     fData5 
# 0.74074074 0.11111111 0.03703704 0.07407407 0.00000000 0.03703704 0.59320640 0.14725533 0.05993024 0.09355886 0.03220171 
#     fData6  X-squared          P 
# 0.07384745 2.94078573 0.70911461 

## Conclusion: Enrichment seen only for promoters.

### PLOTS 
d1 <- cbind.data.frame(probeset=factor(rep(c("FDR-significant sites", 
                                             "All sites tested"), 3), 
                                       levels=c("FDR-significant sites", 
                                                "All sites tested")), 
                       annot=factor(c(rep("Promoter", 2), rep("Enhancer", 2), rep("DHS", 2)),
                                    levels=c("Promoter", "Enhancer", "DHS")), 
                       prop = c(ch2[c(2,4)], ch1[c(2,4)], ch3[c(2,4)]))
d1
p1 <- ggplot(d1, aes(x=annot, y=prop, group=probeset)) + 
  geom_bar(stat="identity", aes(fill=probeset), position = "dodge", width=0.7, 
           col = 'black', alpha =0.77) + 
  scale_fill_manual(values=c("#2b8cbe", "grey")) + 
  labs(x=NULL, y="Proportion") + 
  theme_bw() + 
  ggtitle("A")+
  theme(plot.title.position = "plot",
        plot.title = element_text(face="bold"))+
  theme(legend.title = element_blank(), 
        panel.grid.major.x = element_blank(), 
        text = element_text(family = "Gill Sans", size = 22))
p1
# next:
fdr = table(fdr2$Relation_to_UCSC_CpG_Island)/sum(unname(table(fdr2$Relation_to_UCSC_CpG_Island)))
rest = table(fData2$Relation_to_UCSC_CpG_Island)/sum(unname(table(fData2$Relation_to_UCSC_CpG_Island)))

d2 <- cbind.data.frame(probeset=factor(c(rep("FDR-significant sites", 6),
                                         rep("All sites tested", 6)), 
                                       levels=c("FDR-significant sites", 
                                                "All sites tested")), 
                       annot=factor(c(names(fdr),names(rest)),
                                    levels=c("Open Sea", "N_Shelf", "N_Shore", 
                                             "Island", "S_Shore", "S_Shelf"),
                                    labels=c("Open Sea", "N. Shelf", "N. Shore", 
                                             "Island", "S. Shore", "S. Shelf")), 
                       prop=c(unname(fdr), unname(rest)))
rm(fdr, rest)

p2 <- ggplot(d2, aes(x=annot, y=prop, group=probeset)) + 
  geom_bar(stat="identity", aes(fill=probeset), position = "dodge", width=0.7, 
           col ='black', alpha = 0.77) + 
  scale_fill_manual(values=c("#2b8cbe", "grey")) + 
  labs(x=NULL, y="Proportion") + 
  theme_bw() + 
  theme(plot.title.position = "plot",
        plot.title = element_text(face="bold"))+
  ggtitle("B") + 
  theme(legend.title = element_blank(), 
        panel.grid.major.x = element_blank(), 
        text = element_text(family = "Gill Sans", size = 22))
p2

setwd('~/Results')

tiff("enrich_funct_regions_cellmod_2times_all_nobatches_childAge.tiff", width =14 , height = 9, units="in", pointsize=1,res=300)
grid.arrange(p1, p2, ncol = 1)
dev.off()  

