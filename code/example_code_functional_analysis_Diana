library(gdata)
library(ggrepel) # needed for plotting
library(dplyr)
library(data.table)
library(BiocManager) 
library(gprofiler2) # for pathway analysis plotting
# BiocManager::install("sesame") # install for the first time
# The following initializes usage of Bioc devel
# BiocManager::install(version='devel')
# BiocManager::install(c("sesameData", "BiocFileCache", "ExperimentHub"), force=T)
library(sesameData)
library(BiocFileCache)
library(ExperimentHub)
library(sesame)

# # download all databases
sesameDataCache()


# set WD
setwd("~/Pathway_analysis")

# load results of EWAS
load("child.results.cellmod_2times_nobatches_childAge_2025-09-08.Rdata") 
# dim(sxab); dim(phab)
top_unique<-read.csv("topFDR_cellmod_2times_nobatches_childAge_all_sortByPval_annovar_pathwayAnalysis.csv") # only the top hits 
manifest<-read.csv("EPIC-8v2-0_A1.csv", skip=7, header=T) # Illumina annotation file. same as in line 44 of this code. 
universe<-as.data.frame(lapply(sxab, unlist)) # Just specify your EWAS results as a data.frame here; do NOT use unlist. 
universe<- universe %>% distinct(CpG, .keep_all=T) %>% select(CpG)
universe$IlmnID<- ifelse(universe$CpG %in% manifest$Name, manifest$IlmnID, NA)
# rm(anyab, phab, sxab)

# prepare input data
# query<- top_unique$CpG # modified probe name
query2<- manifest %>% filter(Name %in% top_unique$CpG) %>% select(IlmnID, Name) # original probe name

# Fisher's Exact Test for enrichment for different molecular features using original probe name
# Note: Do not include "EPIC" as the platform, the program will recognize it by the input data
res<-testEnrichment(query2$IlmnID, universe=universe$IlmnID) 
head(res)
# head top findings
res %>% dplyr::filter(overlap>10) %>% dplyr::select(dbname, estimate, test, FDR, overlap) %>% head
res %>% dplyr::filter(FDR<0.05) %>% dplyr::select(dbname, estimate, test, FDR, overlap) %>% print
# any enrichment?
table(res$FDR<0.05) # 36
# table(res$FDR<0.1) # 
table(res$p.value<0.05) # 331
# TIDY UP "estimate" column for Dot plot
res$estimate<-round(res$estimate, 2)

# output expected:
#' estimate= fold change using log2(OR) test. 
#' one-sided or two-sided p value, depending how it was specified in the analysis
#' dbname= name of database
#' FDR correction
#' nQ = length of query set
#' nD = length of database set
#' overlap between nQ and nD
#' Results are sorted by FDR and the magnitude of the estimate

# save results of enrichment analysis
write.csv(res %>% filter(FDR<0.05) %>% arrange(FDR), file="topEnrichedFeatures_FDRlLower0.05_KCYG_sesame_cellmod_2times_nobatches_childAge_all_09.08.25.csv", row.names = F)

# save plots
# enrichment all-databases barplot
tiff("enrichment_KYCG_sesame_enrichAllplot_cellmod_2times_nobatches_childAge.tiff", width =10 , height = 6, units="in", pointsize=1,res=300, compression="lzw")
KYCG_plotEnrichAll(res) # barplot
dev.off()
# dot plot
tiff("enrichment_KYCG_sesame_Dotplot_cellmod_2times_nobatches_childAge.tiff", width =10 , height = 6, units="in", pointsize=1,res=300, compression="lzw")
KYCG_plotDot(res) # set max results to plot to print clear estmate legend , n=20
dev.off()
# volcano plot
tiff("enrichment_KYCG_sesame_Volcanoplot_cellmod_2times_nobatches_childAge.tiff", width =10 , height = 6, units="in", pointsize=1,res=300, compression="lzw")
KYCG_plotVolcano(res) 
dev.off() 

# Gene enrichmet analysis
res2<- testEnrichment(query2$IlmnID,KYCG_buildGeneDBs(query2$IlmnID, max_distance=100000))
dim(res2) # 213
res2[1:20, c("dbname","estimate","gene_name","FDR", "nQ", "nD", "overlap")]
table(res2$FDR < 0.05) # 161
# save results
write.csv(res2 %>% filter(FDR<0.05) %>% arrange(FDR), file="geneEnrichm_KCYG_sesame_cellmod_2times_nobatches_childAge_all_09.08.25.csv", row.names = F)
# # lolipop Plot (not very nice; did my own barplot in excel exporting the table from res2)
tiff("GeneEnrichment_KYCG_sesame_lolipop_cellmod_2times_nobatches_childAge.tiff", width =16 , height = 8, units="in", pointsize=1,res=300, compression="lzw")
KYCG_plotLollipop(res2, label="gene_name")
dev.off()


# Pathway enrichment
## use improved gene name from FDR signals
gostres <- gost(unique(top_unique$nearGene_improv), organism = "hsapiens")
dim(gostres$result)

## This plot was done online for better output https://biit.cs.ut.ee/gprofiler/gost
## input is the list of genes annotated to CpGs detected in main model with FDR < 0.05
tiff("pathwayAnalysis_KYCG_sesame_plot_cellmod_2times_nobatches_childAge.tiff", width =13 , height = 6, units="in", pointsize=1,res=300, compression="lzw")
gostplot(gostres, interactive=F)
dev.off()

# tidy up dataset
table_pathways<-gostres$result
table_pathways$source<-as.factor(table_pathways$source)
table_pathways<- table_pathways %>% arrange(p_value, source)
# save results
write.csv(table_pathways %>% select(-parents), file="pathwayAnal_gostres_KYCG_sesame_cellmod_2times_nobatches_childAge_all_09.08.25.csv", row.names = F)

