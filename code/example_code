############################################
#Define plotting function
############################################


correlationPlot<-function(xdata,ydata,xlab=NULL,ylab=NULL, metabtext=NULL, dot_colour="dark blue", slack=NULL, xrange=NULL, plot_title=NULL)
{



#pass on the betas and se
betax=xdata[,"beta"] #analysis1
xlow=xdata[,"lci"]   #analysis1
xhigh=xdata[,"uci"]  #analysis1

betay=ydata[,"beta"] #analysis2
ylow=ydata[,"lci"]   #analysis2
yhigh=ydata[,"uci"]  #analysis2

if (is.null(xrange)){xrange=range(c(xlow,xhigh,ylow,yhigh))}



#colours of dots
#col.out='dark blue'     #'darkorange' dark green



#the corrsepondence
fit=lm(betay~betax,na.action=na.exclude)
slope=summary(fit)$coef['betax',1:2]; slopep=format(round(slope,2),nsmall=2)
intercept=summary(fit)$coef[1,1:2]; interceptp=format(round(intercept,3),nsmall=2)
slopep=paste(slopep[1],'±',slopep[2])
interceptp=paste(interceptp[1],'±',interceptp[2])
rsquared=summary(fit)$r.squared; rsquaredp=round(rsquared,2)

#the plots
plot(betay,betax,xlim=xrange,ylim=xrange,xlab='',ylab='',type='n',xaxt='n',yaxt='n', main=plot_title, adj=0)

if (slope[1]>=0) abline(a=0,b=1,col='black',lwd=3,lty=2) else
  abline(a=0,b=-1,col='black',lwd=3,lty=2)

axis(side=1,line=0,at=0,labels=0,tick=T,tcl=1,lwd.ticks=2);
axis(side=2,line=0,at=0,labels=0,tick=T,tcl=1,lwd.ticks=2);
axis(side=4,line=0,at=0,labels=NA,tick=T,tcl=1,lwd.ticks=2);

#add the axis
at=pretty(xrange)
ind=which.min(abs(at))
at=at[-ind]
axis(side=1,line=0,at=at,labels=at,tick=T,tcl=0.5);
axis(side=2,line=0,at=at,labels=at,tick=T,tcl=0.5);
crossr=xrange*0.1
segments(crossr[1],0,crossr[2],0,lwd=1.5)
segments(0,crossr[1],0,crossr[2],lwd=1.5)
segments(xlow,betay,xhigh,betay,col='grey75')
segments(betax,ylow,betax,yhigh,col='grey75')
abline(fit,col="red",lwd=3,lty=2)
points(betax,betay, col=dot_colour, cex=0.75,pch=19,lwd=2)
points(betax[dot_colour=="orange"],betay[dot_colour=="orange"], col=dot_colour[dot_colour=="orange"], cex=0.75,pch=19,lwd=2)
box(which='plot',col='grey25',lwd=1.5)

##add the x-lab and y-lab
#mtext(xlab,side=1,line=2.5,cex=1.2)
#mtext(ylab,side=2,line=2.5,cex=1.2)


# x-label
mtext(text="[% methylation difference (95% CI)]",side = 1, line =2, at =0.0,cex=1,col='dimgrey')
mtext(text=xlab,side = 1, line =3, at =0.0,cex=1.2)
# y-label
mtext(text="[% methylation difference (95% CI)]",side = 2, line =2, at =0.0,cex=1,col='dimgrey')
mtext(text=ylab,side = 2, line =3, at =0.0,cex=1.2)



#legends
if (slope[1]>=0)
{
  text(xrange[1],xrange[2]*0.95,labels=paste('Slope = ',(slopep),sep=''),cex=1.2,col="black",adj=c(0,0.5))
  text(xrange[1],xrange[2]*0.85,labels=paste('Intercept = ',interceptp,sep=''),cex=1.2,col="black",adj=c(0,0.5))
  text(xrange[1],xrange[2]*0.75,labels=substitute(paste(italic('R'^'2'),' = ',rsquaredp,sep=''),list(rsquaredp=rsquaredp)),cex=1.2,col="black",adj=c(0,0.5)) 
}  
if (slope[1]<0)
{
  text(xrange[2],xrange[2]*0.95,labels=paste('Slope = ',(slopep),sep=''),cex=1.2,col="black",adj=c(1,0.5))
  text(xrange[2],xrange[2]*0.85,labels=paste('Intercept = ',interceptp,sep=''),cex=1.2,col="black",adj=c(1,0.5))
  text(xrange[2],xrange[2]*0.75,labels=substitute(paste(italic('R'^'2'),' = ',rsquaredp,sep=''),list(rsquaredp=rsquaredp)),cex=1.2,col="black",adj=c(1,0.5)) 
} 



#define how variablenames will be shown
residuals=fit$residuals
names(residuals)=xdata$label.no.units
if (slope[1]>=0) text.pos=c(4,2) else txt.pos=c(2,4)

#select the ones with large residuals

if (is.null(metabtext)){
  sres=sort(abs(residuals),decreasing = T)
  sres=sres[1:floor(length(sres)*0.1)]
  sresname=names(sres)}
#else{
 # sresname=metabtext}



sresiduals=residuals[sresname]

rmark=sign(sresiduals)

rpos=sapply(rmark,function(x){if (x<0) text.pos[1] else text.pos[2]})
ind1=which(rpos==text.pos[1])
ind2=which(rpos==text.pos[2])

rbetax=xdata[match(sresname,as.character(xdata$label.no.units)),'beta']
rbetay=ydata[match(sresname,as.character(xdata$label.no.units)),'beta']
#text(rbetax[ind1],rbetay[ind1]+0.01*abs(xrange[2])*rmark[ind1],sresname[ind1],cex=0.7,col='grey25',font=1,pos=rpos[ind1],offset=0.5)
#text(rbetax[ind2],rbetay[ind2]+0.01*abs(xrange[2])*rmark[ind2],sresname[ind2],cex=0.7,col='grey25',font=1,pos=rpos[ind2],offset=0.5)



# reference line
legend(par('usr')[1],par('usr')[3],horiz=T,box.col='transparent',xpd=NA,legend='Reference line (slope=1, intercept=0)',col = "black" ,lwd=2,lty = "dashed", yjust=4,xjust =-4 ,cex=0.8,text.width=0.03)


}

############################################
#load libraries, set wd and load data
############################################

library(meffil)
setwd("[pathname]")

#load data
results_one<- read.csv([path_to_ewas_results_analysis_one])

results_two<- read.csv([path_to_ewas_results_analysis_one])

############################################
#create table of overlaps
############################################
#get p val threshold used for results_one
threshold<-0.05/dim(results_one)[1]

# subset associated CpGs at results_one
results_one<-results_one[results_one$p.none<(0.05/dim(results_one)[1]),]
dim(results_one) #32435
table(results_two$probeID %in% results_one$probeID)

#check which probes are missing as not included on epic array
epic_annotation <- meffil.get.features("epic")
table(epic_annotation$name %in% results_one$probeID) 

results_two<-results_two[results_two$probeID %in% results_one$probeID,]
results_one<-results_one[results_one$probeID %in% results_two$probeID,]

#order
results_one<-results_one[order(results_one$probeID),]
results_two<-results_two[order(results_two$probeID),]

identical(as.character(results_one$probeID), as.character(results_two$probeID))

#add columns needed
results_one$beta<-(results_one$coef.none)
results_one$lci<-results_one$beta + (1.96 * results_one$se.none)
results_one$uci<- results_one$beta - (1.96 * results_one$se.none)

results_two$beta<-(results_two$coef.none)
results_two$lci<-results_two$beta + (1.96 * results_two$se.none)
results_two$uci<- results_two$beta - (1.96 * results_two$se.none)

#multiply by 100 to give percentage diff in methylation rather than beta values
#results_one$beta<-results_one$beta*100
#results_one$lci<-results_one$lci*100
#results_one$uci<-results_one$uci*100
#results_two$beta<-results_two$beta*100
#results_two$lci<-results_two$lci*100
#results_two$uci<-results_two$uci*100

#colour code points on plots by p val threshold attainment in results_two
results_two$colour<-"dark grey"
results_two$colour[results_two$p.none<threshold]<-"orange"

pdf(file= "./plots/results_two_results_one_correlation.pdf", height=7, width=7)
correlationPlot(xdata=results_one,ydata=results_two,xlab="results_one",ylab="results_two", metabtext=NULL, dot_colour=results_two$colour)
dev.off()

